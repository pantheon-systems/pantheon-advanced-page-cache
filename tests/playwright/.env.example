# WordPress site credentials
WP_URL=https://<env>-pantheon-advanced-page-cache.pantheonsite.io
WP_USER=pantheon
WP_PASSWORD=

# Browser settings
HEADLESS=true
SLOW_MO=0

# Allowlisted CI User-Agent. Without it, Cloudflare serves a bot challenge
# on Cloudflare-fronted environments and the browser tests cannot load a page.
CI_UA=
