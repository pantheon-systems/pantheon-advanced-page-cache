{
  "name": "papc-e2e",
  "version": "1.0.0",
  "description": "End-to-end tests for the Pantheon Advanced Page Cache plugin",
  "private": true,
  "scripts": {
    "test": "bddgen && playwright test",
    "test:headed": "bddgen && HEADLESS=false playwright test",
    "test:debug": "bddgen && playwright test --debug",
    "test:ui": "bddgen && playwright test --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "cms-bdd": "git+https://github.com/pantheon-systems/cms-bdd.git#253735e393105a2afd428c851a2a97938b7bd149",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "allure-playwright": "3.14.0",
    "playwright": "1.64.1",
    "playwright-bdd": "9.2.1",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
